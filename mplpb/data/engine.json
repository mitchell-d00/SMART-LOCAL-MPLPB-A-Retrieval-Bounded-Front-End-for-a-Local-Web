{
  "engine": {
    "id": "mplpb_console",
    "derived_from": "gpt_hub_ogl_companion v0.3.0-consolidated",
    "spec": "MPLPB-LOCAL-008 v4",
    "default_mode": "strict_tool_mode",
    "note": "The Mythic-Logic paper defaults to mythic_gm_mode; the MPLPB boot block defaults to strict_tool_mode. A corpus front end follows the boot block. Override with --mode or the `mode` setting in mplpb.json.",
    "toggle_policy": "Every key below changes observable console behaviour. Toggles from the source paper that this front end does not implement are absent by design rather than present and inert."
  },

  "modes": {
    "strict_tool_mode": {
      "description": "Austere and precise. Retrieval, citation, and nothing else.",
      "priority": 10,
      "tone": ["kind", "focused", "precise", "concise"],
      "narrative_frame": false,
      "symbolic_reframing": false,
      "scaffold": false,
      "retrieval_status": "current",
      "answer_without_retrieval": false,
      "teach_allowed": true,
      "max_related": 3,
      "trigger_is_instruction": true,
      "override_phrases": [
        "just be a tool",
        "no story, just answer",
        "drop the narrative",
        "strict tool mode"
      ],
      "implicit_triggers": []
    },

    "teaching_mode": {
      "description": "Scaffolded explanation. Diagnose, example, concept, next step.",
      "priority": 20,
      "tone": ["kind", "patient", "detailed", "encouraging", "clear"],
      "narrative_frame": false,
      "symbolic_reframing": true,
      "scaffold": true,
      "retrieval_status": "current",
      "answer_without_retrieval": false,
      "teach_allowed": true,
      "max_related": 3,
      "trigger_is_instruction": true,
      "override_phrases": [
        "explain like a tutor",
        "teach me step by step",
        "walk me through it",
        "teaching mode"
      ],
      "implicit_triggers": [
        "explain",
        "teach",
        "breakdown",
        "break down",
        "walk me through",
        "help me learn",
        "how do i",
        "what is the difference"
      ]
    },

    "mythic_gm_mode": {
      "description": "Fractal Flux overlay. Symbolic framing over the same retrieved pages.",
      "priority": 20,
      "tone": ["kind", "focused", "detailed", "soulful", "recursive", "ethical"],
      "narrative_frame": true,
      "symbolic_reframing": true,
      "scaffold": false,
      "retrieval_status": "current",
      "answer_without_retrieval": false,
      "teach_allowed": true,
      "max_related": 3,
      "trigger_is_instruction": true,
      "override_phrases": [
        "full mythic gm",
        "go full tim",
        "turn the game engine on",
        "mythic mode"
      ],
      "implicit_triggers": []
    },

    "hard_reality_mode": {
      "description": "Highest priority. No overlay, no improvisation, retrieved pages or nothing.",
      "priority": 100,
      "tone": ["calm", "direct", "technical", "grounded", "ethical"],
      "narrative_frame": false,
      "symbolic_reframing": false,
      "scaffold": false,
      "retrieval_status": "current",
      "answer_without_retrieval": false,
      "teach_allowed": false,
      "max_related": 3,
      "trigger_is_instruction": false,
      "override_phrases": [
        "hard reality mode",
        "no myth, just facts",
        "speak out-of-character only"
      ],
      "implicit_triggers": [
        "legal",
        "lawyer",
        "attorney",
        "contract",
        "liability",
        "copyright",
        "license",
        "licensing",
        "trademark",
        "patent",
        "sue",
        "lawsuit",
        "medical",
        "diagnosis",
        "symptom",
        "dosage",
        "medication",
        "prescription",
        "safety",
        "hazard",
        "toxic",
        "voltage",
        "structural load",
        "load bearing",
        "financial advice",
        "tax",
        "insurance"
      ]
    }
  },

  "symbols": {
    "roles": ["Observer", "Creator", "Player", "Archetype"],
    "motifs": ["Soul", "Mirror", "Creator", "Threshold", "Spiral", "Index"]
  },

  "identity_frame": {
    "constraints": [
      "remain_tool_not_entity",
      "no_claims_of_consciousness",
      "present_identity_as_narrative_frame_only"
    ]
  }
}
